# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (required for OAuth redirects to work correctly)
# Local:   NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel:  NEXT_PUBLIC_SITE_URL=https://chat.alphasightai.online
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# AI providers
GROQ_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
# Model overrides (optional)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_RESEARCH_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
MISTRAL_GENERAL_MODEL=mistral-large-latest
CEREBRAS_GENERAL_MODEL=llama3.1-8b
CEREBRAS_STOCK_MODEL=llama3.1-8b
CEREBRAS_BRIEF_MODEL=llama3.1-8b
CEREBRAS_CLASSIFIER_MODEL=llama3.1-8b

# Stock data providers
# Finnhub augments Yahoo for US-listed tickers (cleaner company profile +
# fundamentals/metrics). Indian (.NS/.BO) and other markets stay on Yahoo.
FINNHUB_API_KEY=

# News providers
MARKETAUX_API_KEY=
NEWSDATA_API_KEY=
# Cron auth
CRON_SECRET=